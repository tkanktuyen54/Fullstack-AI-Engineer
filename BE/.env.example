# Copy to BE/.env to customize this team's local configuration.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
MYSQL_PORT=3307
DATABASE_PASSWORD=khoa_local_password
MYSQL_ROOT_PASSWORD=root_local_password

# Shared with the internal Python advisor. No external model API key is required.
AI_SERVICE_TOKEN=
AI_ENVIRONMENT=development
AI_REQUIRE_KNOWLEDGE=true
AI_READINESS_REQUIRE_LLM=false
AI_MAX_ACTIVE_REQUESTS=8
AI_MEMORY_LIMIT=2g
AI_READ_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=75

# Local Ollama on the Docker host; native Python uses http://127.0.0.1:11434.
AI_LLM_ENABLED=true
AI_OLLAMA_URL=http://host.docker.internal:11434
AI_LLM_MODEL=qwen3:0.6b
AI_LLM_THINKING=false
AI_LLM_CONTEXT_TOKENS=2048
AI_LLM_MAX_OUTPUT_TOKENS=256
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_KEEP_ALIVE=1m
# Optional trained intent checkpoint inside the advisor container.
# AI_MODEL_PATH=/app/artifacts/intents.pt
