# Export these variables before starting uvicorn; this file is not loaded automatically.
AI_ENVIRONMENT=development
# Required in production: generate a random value of at least 32 characters, shared with BE.
AI_SERVICE_TOKEN=
AI_REQUIRE_KNOWLEDGE=true
AI_READINESS_REQUIRE_LLM=false
# Default: incremental in development, complete in production. Leave unset for that default.
# AI_STREAM_VALIDATION=incremental
AI_MAX_ACTIVE_REQUESTS=8
AI_LLM_ENABLED=true
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_LLM_MODEL=qwen3:0.6b
AI_LLM_THINKING=false
AI_LLM_CONTEXT_TOKENS=2048
AI_LLM_MAX_OUTPUT_TOKENS=256
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_KEEP_ALIVE=1m
