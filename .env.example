# Optional: copy to .env in the repository root before running docker compose up.
# The root Compose file reads this .env, not BE/.env or FE/.env.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=4201
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8081
MYSQL_PORT=3307
DATABASE_PASSWORD=khoa_local_password
MYSQL_ROOT_PASSWORD=root_local_password

# MCP employee endpoint: add your deployment host/origin if accessing beyond localhost.
EMPLOYEE_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,backend:8080
EMPLOYEE_MCP_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Shared by the backend and the internal Python advisor.
AI_SERVICE_TOKEN=
AI_ENVIRONMENT=development
AI_REQUIRE_KNOWLEDGE=true
AI_READINESS_REQUIRE_LLM=true
AI_MAX_ACTIVE_REQUESTS=8
AI_MEMORY_LIMIT=2g
AI_READ_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=75

# Ollama runs inside Compose using CPU; ollama-init downloads this model.
# AI_OLLAMA_URL is set to http://ollama:11434 in compose.yaml.
AI_LLM_ENABLED=true
AI_LLM_MODEL=qwen3:0.6b
AI_LLM_THINKING=false
AI_LLM_CONTEXT_TOKENS=2048
AI_LLM_MAX_OUTPUT_TOKENS=256
AI_LLM_TIMEOUT_SECONDS=45
AI_LLM_KEEP_ALIVE=1m
# To disable LLM generation, set AI_LLM_ENABLED=false and AI_READINESS_REQUIRE_LLM=false.
# Optional trained intent checkpoint inside the advisor container.
# AI_MODEL_PATH=/app/artifacts/intents.pt
